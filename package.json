{
  "name": "synapse-guard-public-demo",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "node --check app.mjs && node --check v1-engine.mjs && npm test && npm run build",
    "dev": "npm run build && wrangler dev --local",
    "deploy:dry-run": "npm run check && wrangler deploy --dry-run",
    "deploy": "node scripts/deploy.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": { "wrangler": "4.149.0" }
}
